# Copy to .env.local. Local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Used to send invite emails.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Any long random string. Vercel sends it to the keep-awake cron route.
CRON_SECRET=replace-with-a-long-random-string
# Local only. On Vercel the production address is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: browser tests against a separate local stack's mail service.
# E2E_MAILPIT_URL=http://127.0.0.1:54324
# Optional: database tests using a separate local Supabase config directory.
# SUPABASE_WORKDIR=/path/to/stack
# Optional: explicit container socket; database tests auto-detect rootless Podman.
# DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
